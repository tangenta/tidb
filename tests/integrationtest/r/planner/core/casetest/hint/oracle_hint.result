TableReader	root		data:Selection
└─Selection	cop[tikv]		eq(test.t_full1.a, 1)
  └─TableFullScan	cop[tikv]	table:t_full1	keep order:false, stats:pseudo
explain format='plan_tree' select /*+ FULL(t_full1) */ * from t_full1 join t_full2 on t_full1.a = t_full2.a where t_full1.a = 1;
id	task	access object	operator info
IndexHashJoin	root		inner join, inner:IndexLookUp, outer key:test.t_full1.a, inner key:test.t_full2.a, equal cond:eq(test.t_full1.a, test.t_full2.a)
