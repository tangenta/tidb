  ├─Selection(Build)	cop[tikv]		eq(test.t_full2.a, 1)
  │ └─IndexRangeScan	cop[tikv]	table:t_full2, index:a(a)	range: decided by [eq(test.t_full2.a, test.t_full1.a)], keep order:false, stats:pseudo
  └─TableRowIDScan(Probe)	cop[tikv]	table:t_full2	keep order:false, stats:pseudo
explain format='plan_tree' select /*+ FULL(t_full1, t_full2) */ * from t_full1 join t_full2 on t_full1.a = t_full2.a where t_full1.a = 1;
